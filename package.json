{
  "name": "mad-toolbox",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build:lite": "node scripts/build/build.js --edition lite",
    "tauri:build:full": "node scripts/build/build.js --edition full",
    "check": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit",
    "i18n:check": "node scripts/i18n/check.mjs",
    "format": "prettier --write . --ignore-unknown",
    "format:check": "prettier --check . --ignore-unknown",
    "version:bump": "node scripts/version/bump.js",
    "version:check": "node scripts/version/check.js"
  },
  "dependencies": {
    "@mantine/carousel": "^9.5.1",
    "@mantine/core": "^9.5.1",
    "@mantine/hooks": "^9.5.1",
    "@mantine/notifications": "^9.5.1",
    "@tabler/icons-react": "^3.46.0",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "@tauri-apps/plugin-opener": "^2.0.0",
    "embla-carousel-react": "^8.6.0",
    "i18next": "^26.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "prettier": "3.9.6",
    "typescript": "~5.7.2",
    "vite": "^6.0.3"
  }
}
