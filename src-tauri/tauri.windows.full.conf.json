      "../third_party/licenses/FFmpeg-LGPL-2.1.txt": "licenses/FFmpeg-LGPL-2.1.txt",
      "../third_party/licenses/FFmpeg-LGPL-3.0.txt": "licenses/FFmpeg-LGPL-3.0.txt",
