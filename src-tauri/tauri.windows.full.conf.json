{
  "app": {
    "macOSPrivateApi": false,
    "windows": [
      {
        "title": "MAD Toolbox",
        "width": 1120,
        "height": 760,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "zoomHotkeysEnabled": true
      }
    ]
  },
  "bundle": {
    "targets": ["nsis"],
    "externalBin": [],
    "resources": {
      "binaries/BBDown-x86_64-pc-windows-msvc.exe": "dependencies/BBDown/BBDown.exe",
      "binaries/ffmpeg-x86_64-pc-windows-msvc.exe": "dependencies/FFmpeg/ffmpeg.exe",
      "binaries/ffprobe-x86_64-pc-windows-msvc.exe": "dependencies/FFmpeg/ffprobe.exe",
      "binaries/mediainfo-x86_64-pc-windows-msvc.exe": "dependencies/MediaInfo/mediainfo.exe",
      "binaries/yt-dlp-x86_64-pc-windows-msvc.exe": "dependencies/yt-dlp/yt-dlp.exe",
      "binaries/deno-x86_64-pc-windows-msvc.exe": "dependencies/Deno/deno.exe",
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md",
      "../third_party/sources.json": "third_party/sources.json",
      "../third_party/windows-sources.json": "third_party/windows-sources.json",
      "../third_party/licenses/BBDown-MIT.txt": "licenses/BBDown-MIT.txt",
      "../third_party/licenses/BtbN-FFmpeg-Builds-MIT.txt": "licenses/BtbN-FFmpeg-Builds-MIT.txt",
      "../third_party/licenses/curl.txt": "licenses/curl.txt",
      "../third_party/licenses/Deno-MIT.md": "licenses/Deno-MIT.md",
      "../third_party/licenses/FFmpeg-LGPL-2.1.txt": "licenses/FFmpeg-LGPL-2.1.txt",
      "../third_party/licenses/FFmpeg-LGPL-3.0.txt": "licenses/FFmpeg-LGPL-3.0.txt",
      "../third_party/licenses/FFmpeg-LICENSE.md": "licenses/FFmpeg-LICENSE.md",
      "../third_party/licenses/MediaInfo-License.html": "licenses/MediaInfo-License.html",
      "../third_party/licenses/yt-dlp-Unlicense.txt": "licenses/yt-dlp-Unlicense.txt",
      "../third_party/licenses/yt-dlp-THIRD_PARTY_LICENSES.txt": "licenses/yt-dlp-THIRD_PARTY_LICENSES.txt",
      "resources/MediaInfo-LIBCURL.DLL": "dependencies/MediaInfo/LIBCURL.DLL",
      "resources/musicdl-adapter.py": "musicdl-adapter.py"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller",
        "silent": true
      },
      "allowDowngrades": false,
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": false,
        "compression": "lzma"
      }
    }
  }
}
