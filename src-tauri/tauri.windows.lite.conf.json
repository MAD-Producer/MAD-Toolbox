{
  "app": {
    "macOSPrivateApi": false,
    "windows": [
      {
        "title": "MAD Toolbox",
        "width": 1120,
        "height": 760,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "zoomHotkeysEnabled": true
      }
    ]
  },
  "bundle": {
    "targets": ["nsis"],
    "externalBin": [],
    "resources": {
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md",
      "../third_party/windows-sources.json": "third_party/windows-sources.json",
      "../third_party/licenses/BBDown-MIT.txt": "licenses/BBDown-MIT.txt",
      "resources/musicdl-adapter.py": "musicdl-adapter.py"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "skip"
      },
      "allowDowngrades": false,
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": false,
        "compression": "lzma"
      }
    }
  }
}
